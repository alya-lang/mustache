# Mustache Template Engine - Context & Value Inspection
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"

## Checks if a value is a valid heap pointer in 64-bit user address space.
pub function is_heap_pointer(v)
    if v is null or v == 0
        return 0
    end
    # Range check for 64-bit user pointers: [65536, 0x00007fffffffffff]
    if v < 65536 or v > 140737488355327
        return 0
    end
    return 1
end

## Checks if a value is an Alya list/array.
pub function is_list(v)
    if is_heap_pointer(v) == 0
        return 0
    end
    let magic = peek_int(v, -16)
    return magic == 1511063553
end

## Checks if a value is an Alya map/hash object.
pub function is_map_obj(v)
    if is_heap_pointer(v) == 0
        return 0
    end
    let magic = peek_int(v, -16)
    return magic == 1511063554
end

## Checks if a value is truthy according to Mustache rules:
## - null, 0, false, empty string "", empty array [] are falsy (0)
## - everything else (including empty map or non-empty string/array/number) is truthy (1)
pub function is_truthy(v)
    if v is null or v == 0
        return 0
    end
    if is_list(v)
        return len(v) > 0
    end
    if is_heap_pointer(v) == 0
        # Non-zero scalar number or boolean true
        return 1
    end
    let magic = peek_int(v, -16)
    if magic == 1511063554
        # Maps are always truthy in Mustache
        return 1
    end
    # Check string length
    let s = str(v)
    return len(s) > 0
end

## Checks if a map contains a specified key.
pub function map_has_key(m, key)
    if is_map_obj(m) == 0
        return 0
    end
    return key in m
end

## Resolves a key (supports '.' for implicit iterator and dot-notation for nested paths) in a single scope.
pub function resolve_in_scope(scope, key)
    if key == "."
        return make_lookup_result(1, scope)
    end
    if is_map_obj(scope) == 0
        return make_lookup_result(0, null)
    end
    if key.contains(".")
        let parts = key.split(".")
        let cur = scope
        for part in parts
            if is_map_obj(cur) == 0
                return make_lookup_result(0, null)
            end
            if part not in cur
                return make_lookup_result(0, null)
            end
            cur = cur[part]
        end
        return make_lookup_result(1, cur)
    end
    if key in scope
        return make_lookup_result(1, scope[key])
    end
    return make_lookup_result(0, null)
end

## Searches a context stack from top (most local scope) to bottom (global scope).
pub function context_find(stack, key)
    let count = len(stack)
    if count == 0
        return make_lookup_result(0, null)
    end
    let i = count - 1
    while i >= 0
        let scope = stack[i]
        let res = resolve_in_scope(scope, key)
        if res.lookup_found == 1
            return res
        end
        i -= 1
    end
    return make_lookup_result(0, null)
end

## Pushes a new scope onto the context stack.
pub function MustacheContext.push(self, scope)
    self.ctx_stack.push(scope)
    return self
end

## Pops the top scope from the context stack.
pub function MustacheContext.pop(self)
    return self.ctx_stack.pop()
end

## Searches for a key within the context stack hierarchy.
pub function MustacheContext.find(self, key)
    return context_find(self.ctx_stack, key)
end

## Creates a new MustacheContext initialized with an optional scope map.
pub function make_context(initial_scope = {})
    return MustacheContext {
        ctx_stack: [initial_scope]
    }
end
