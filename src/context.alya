## # mustache/context
##
## Mustache template engine context and value inspection.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Resolves dotted keys against stacked scopes with Mustache truthiness.

import "./types.alya"

## Checks whether a value is a valid 64-bit user-space heap pointer.
##
## ### Parameters
## - `v`: Value to inspect.
##
## ### Returns
## `1` for plausible heap addresses, `0` otherwise.
pub function is_heap_pointer(v) -> int
    if v is null or v == 0
        return 0
    end
    # Range check for 64-bit user pointers: [65536, 0x00007fffffffffff]
    if v < 65536 or v > 140737488355327
        return 0
    end
    return 1
end

## Checks whether a value is an Alya list/array.
##
## ### Parameters
## - `v`: Value to inspect.
##
## ### Returns
## `1` for lists, `0` otherwise.
pub function is_list(v) -> int
    if is_heap_pointer(v) == 0
        return 0
    end
    let magic = peek_int(v, -16)
    return magic == 1511063553
end

## Checks whether a value is an Alya map/hash object.
##
## ### Parameters
## - `v`: Value to inspect.
##
## ### Returns
## `1` for maps, `0` otherwise.
pub function is_map_obj(v) -> int
    if is_heap_pointer(v) == 0
        return 0
    end
    let magic = peek_int(v, -16)
    return magic == 1511063554
end

## Checks whether a value is truthy according to Mustache rules.
##
## `null`, `0`, `false`, `""`, and `[]` are falsy; everything else
## (including empty maps) is truthy.
##
## ### Parameters
## - `v`: Value to inspect.
##
## ### Returns
## `1` for truthy values, `0` otherwise.
pub function is_truthy(v) -> int
    if v is null or v == 0
        return 0
    end
    if is_list(v)
        return len(v) > 0
    end
    if is_heap_pointer(v) == 0
        # Non-zero scalar number or boolean true
        return 1
    end
    let magic = peek_int(v, -16)
    if magic == 1511063554
        # Maps are always truthy in Mustache
        return 1
    end
    # Check string length
    let s = str(v)
    return len(s) > 0
end

## Checks whether a map contains a key.
##
## ### Parameters
## - `m`: Target map value.
## - `key`: Key string.
##
## ### Returns
## `1` when the key exists, `0` otherwise.
pub function map_has_key(m, key: string) -> int
    if is_map_obj(m) == 0
        return 0
    end
    return key in m
end

## Resolves a key in a single scope (`.` addresses the scope itself).
##
## Supports dot-notation for nested paths (`a.b.c`).
##
## ### Parameters
## - `scope`: Scope value to search.
## - `key`: Key string.
##
## ### Returns
## The `LookupResult` instance.
pub function resolve_in_scope(scope, key: string) -> LookupResult
    if key == "."
        return make_lookup_result(1, scope)
    end
    if is_map_obj(scope) == 0
        return make_lookup_result(0, null)
    end
    if key.contains(".")
        let parts = key.split(".")
        let cur = scope
        for part in parts
            if is_map_obj(cur) == 0
                return make_lookup_result(0, null)
            end
            if part not in cur
                return make_lookup_result(0, null)
            end
            cur = cur[part]
        end
        return make_lookup_result(1, cur)
    end
    if key in scope
        return make_lookup_result(1, scope[key])
    end
    return make_lookup_result(0, null)
end

## Searches a context stack from top (local) to bottom (global).
##
## ### Parameters
## - `stack`: Scope stack array.
## - `key`: Key string.
##
## ### Returns
## The first matching `LookupResult`, or a miss result.
pub function context_find(stack: array, key: string) -> LookupResult
    let count = len(stack)
    if count == 0
        return make_lookup_result(0, null)
    end
    let i = count - 1
    while i >= 0
        let scope = stack[i]
        let res = resolve_in_scope(scope, key)
        if res.lookup_found == 1
            return res
        end
        i -= 1
    end
    return make_lookup_result(0, null)
end

## Pushes a new scope onto the context stack.
##
## ### Parameters
## - `self`: The target `MustacheContext` instance.
## - `scope`: Scope value to push.
##
## ### Returns
## The updated context instance.
pub function MustacheContext.push(self: MustacheContext, scope) -> MustacheContext
    self.ctx_stack.push(scope)
    return self
end

## Pops the top scope from the context stack.
##
## ### Parameters
## - `self`: The target `MustacheContext` instance.
##
## ### Returns
## The popped scope value.
pub function MustacheContext.pop(self: MustacheContext)
    return self.ctx_stack.pop()
end

## Searches for a key within the context stack hierarchy.
##
## ### Parameters
## - `self`: The target `MustacheContext` instance.
## - `key`: Key string.
##
## ### Returns
## The first matching `LookupResult`, or a miss result.
pub function MustacheContext.find(self: MustacheContext, key: string) -> LookupResult
    return context_find(self.ctx_stack, key)
end

## Creates a new MustacheContext initialized with an optional scope map.
##
## ### Parameters
## - `initial_scope`: Initial scope value. Defaults to `{}`.
##
## ### Returns
## The new `MustacheContext` instance.
pub function make_context(initial_scope = {}) -> MustacheContext
    return MustacheContext {
        ctx_stack: [initial_scope]
    }
end
