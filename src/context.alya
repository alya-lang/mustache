# Mustache Template Engine - Context & Value Inspection
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"

# Checks if a value is a valid heap pointer in 64-bit user address space
function is_heap_pointer(v)
    if v == null or v == 0
        return 0
    end
    # Range check for 64-bit user pointers: [65536, 0x00007fffffffffff]
    if v < 65536 or v > 140737488355327
        return 0
    end
    return 1
end

# Checks if a value is an Alya array
function is_list(v)
    if is_heap_pointer(v) == 0
        return 0
    end
    let magic = peek_int(v, -16)
    return magic == 1511063553
end

# Checks if a value is an Alya map/hash
function is_map_obj(v)
    if is_heap_pointer(v) == 0
        return 0
    end
    let magic = peek_int(v, -16)
    return magic == 1511063554
end

# Checks if a value is truthy according to Mustache rules:
# - null, 0, false, empty string "", empty array [] are falsy (0)
# - everything else (including empty map or non-empty string/array/number) is truthy (1)
function is_truthy(v)
    if v == null or v == 0
        return 0
    end
    if is_list(v)
        return len(v) > 0
    end
    if is_heap_pointer(v) == 0
        # Non-zero scalar number or boolean true
        return 1
    end
    let magic = peek_int(v, -16)
    if magic == 1511063554
        # Maps are always truthy in Mustache
        return 1
    end
    # Check string length
    let s = str(v)
    return len(s) > 0
end

# Checks if a map contains a specified key
function map_has_key(m, key)
    if is_map_obj(m) == 0
        return 0
    end
    let ks = keys(m)
    let count = len(ks)
    let i = 0
    while i < count
        if ks[i] == key
            return 1
        end
        i += 1
    end
    return 0
end

# Resolves a key (supports '.' for implicit iterator and dot-notation for nested paths) in a single scope
function resolve_in_scope(scope, key)
    if key == "."
        return make_lookup_result(1, scope)
    end
    if is_map_obj(scope) == 0
        return make_lookup_result(0, null)
    end
    if key.contains(".")
        let parts = key.split(".")
        let cur = scope
        let count = len(parts)
        let i = 0
        while i < count
            let part = parts[i]
            if is_map_obj(cur) == 0
                return make_lookup_result(0, null)
            end
            if map_has_key(cur, part) == 0
                return make_lookup_result(0, null)
            end
            cur = cur[part]
            i += 1
        end
        return make_lookup_result(1, cur)
    end
    if map_has_key(scope, key)
        return make_lookup_result(1, scope[key])
    end
    return make_lookup_result(0, null)
end

# Searches a context stack from top (most local scope) to bottom (global scope)
function context_find(stack, key)
    let count = len(stack)
    if count == 0
        return make_lookup_result(0, null)
    end
    let i = count - 1
    while i >= 0
        let scope = stack[i]
        let res = resolve_in_scope(scope, key)
        if res.lookup_found == 1
            return res
        end
        i -= 1
    end
    return make_lookup_result(0, null)
end
