## # mustache/renderer
##
## Mustache template engine AST renderer.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Walks variables, sections, inverted blocks, and partials against a
## context stack with HTML escaping for interpolated values.

import "./types.alya"
import "./escape.alya"
import "./context.alya"
import "./parser.alya"

# Checks if a value is a struct (like a precompiled Template).
function is_struct_obj(v) -> int
    if is_heap_pointer(v) == 0
        return 0
    end
    let magic = peek_int(v, -16)
    return magic == 1511063555
end

## Renders an AST node array against a context stack and partials map.
##
## ### Parameters
## - `nodes`: AST node array.
## - `stack`: Scope stack array (mutated during section iteration).
## - `partials`: Named partial template map.
##
## ### Returns
## The rendered output string.
pub function mustache_render_nodes(nodes: array, stack: array, partials) -> string
    let res = ""
    for node in nodes
        let ntype = node.node_type
        when ntype
            is MustacheTagType.Text then
                res += node.node_val
            is MustacheTagType.Variable then
                let lookup = context_find(stack, node.node_val)
                if lookup.lookup_found == 1 and lookup.lookup_val is not null
                    let esc_val = escape_html(str(lookup.lookup_val))
                    res += esc_val
                end
            is MustacheTagType.RawVariable then
                let lookup = context_find(stack, node.node_val)
                if lookup.lookup_found == 1 and lookup.lookup_val is not null
                    res += str(lookup.lookup_val)
                end
            is MustacheTagType.Section then
                let lookup = context_find(stack, node.node_val)
                if lookup.lookup_found == 1
                    let val = lookup.lookup_val
                    if is_list(val) == 1
                        for item in val
                            stack.push(item)
                            res += mustache_render_nodes(node.node_children, stack, partials)
                            stack.pop()
                        end
                    else
                        if is_map_obj(val) == 1
                            stack.push(val)
                            res += mustache_render_nodes(node.node_children, stack, partials)
                            stack.pop()
                        elif is_truthy(val) == 1
                            res += mustache_render_nodes(node.node_children, stack, partials)
                        end
                    end
                end
            is MustacheTagType.Inverted then
                let lookup = context_find(stack, node.node_val)
                let should_render = 0
                if lookup.lookup_found == 0
                    should_render = 1
                elif is_truthy(lookup.lookup_val) == 0
                    should_render = 1
                end
                if should_render == 1
                    res += mustache_render_nodes(node.node_children, stack, partials)
                end
            is MustacheTagType.Partial then
                if node.node_val in partials
                    let p_item = partials[node.node_val]
                    if is_struct_obj(p_item) == 1
                        res += mustache_render_nodes(p_item.tmpl_nodes, stack, partials)
                    else
                        let p_tmpl = mustache_parse(str(p_item))
                        res += mustache_render_nodes(p_tmpl.tmpl_nodes, stack, partials)
                    end
                end
        end
    end
    return res
end

## Renders a compiled Template struct against data and optional partials.
##
## ### Parameters
## - `template`: Compiled `Template` instance.
## - `data`: Root scope value.
## - `partials`: Named partial template map. Defaults to `{}`.
##
## ### Returns
## The rendered output string.
pub function mustache_render_template(template: Template, data, partials = {}) -> string
    let stack = [data]
    return mustache_render_nodes(template.tmpl_nodes, stack, partials)
end

## Renders this Template instance with the provided data and partials.
##
## ### Parameters
## - `self`: The target `Template` instance.
## - `data`: Root scope value. Defaults to `{}`.
## - `partials`: Named partial template map. Defaults to `{}`.
##
## ### Returns
## The rendered output string.
pub function Template.render(self: Template, data = {}, partials = {}) -> string
    return mustache_render_template(self, data, partials)
end
