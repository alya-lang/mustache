# Mustache Template Engine - Types & Constants
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

pub enum MustacheTagType
    Text,
    Variable,
    RawVariable,
    Section,
    Inverted,
    Partial,
    Comment
end

# --- AST Node Definition ---
pub struct Node
    node_type,
    node_val,
    node_children
end

pub function make_node(type_val, val, children = [])
    return Node {
        node_type: type_val,
        node_val: val,
        node_children: children
    }
end

# --- Compiled Template Definition ---
pub struct Template
    tmpl_nodes,
    tmpl_source
end

pub function make_template(nodes, source)
    return Template {
        tmpl_nodes: nodes,
        tmpl_source: source
    }
end

# --- Variable Lookup Result ---
pub struct LookupResult
    lookup_found,
    lookup_val
end

pub function make_lookup_result(found, val)
    return LookupResult {
        lookup_found: found,
        lookup_val: val
    }
end

# --- Context Object Struct Definition ---
pub struct MustacheContext
    ctx_stack
end
