# Mustache Template Engine - HTML Escaping & Sanitization
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Escapes special characters for HTML/XML output
pub function escape_html(text)
    let s = str(text)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        when ch
            is "&"  then res += "&amp;"
            is "<"  then res += "&lt;"
            is ">"  then res += "&gt;"
            is "\"" then res += "&quot;"
            is "'"  then res += "&#39;"
            else         res += ch
        end
        i += 1
    end
    return res
end

# Unescapes standard HTML entities back to raw characters
pub function unescape_html(text)
    let s = str(text)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch == "&"
            if i + 5 <= slen and s[i..i + 5] == "&amp;"
                res += "&"
                i += 5
            elif i + 4 <= slen and s[i..i + 4] == "&lt;"
                res += "<"
                i += 4
            elif i + 4 <= slen and s[i..i + 4] == "&gt;"
                res += ">"
                i += 4
            elif i + 6 <= slen and s[i..i + 6] == "&quot;"
                res += "\""
                i += 6
            elif i + 5 <= slen and s[i..i + 5] == "&#39;"
                res += "'"
                i += 5
            else
                res += ch
                i += 1
            end
        else
            res += ch
            i += 1
        end
    end
    return res
end
