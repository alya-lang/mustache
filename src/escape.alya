# Mustache Template Engine - HTML Escaping & Sanitization
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

## Escapes special HTML characters (&, <, >, ", ') into standard safe HTML entities.
pub function escape_html(text)
    let s = str(text)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        when ch
            is "&"  then res += "&amp;"
            is "<"  then res += "&lt;"
            is ">"  then res += "&gt;"
            is "\"" then res += "&quot;"
            is "'"  then res += "&#39;"
            else         res += ch
        end
        i += 1
    end
    return res
end

## Decodes standard HTML entities (&amp;, &lt;, &gt;, &quot;, &#39;) back to raw characters.
pub function unescape_html(text)
    let s = str(text)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch == "&"
            let semi = -1
            let max_look = if i + 10 < slen then i + 10 else slen
            let j = i + 1
            while j < max_look
                if char_at(s, j) == ";"
                    semi = j
                    break
                end
                j += 1
            end

            if semi > i
                let entity = substring(s, i, semi - i + 1)
                when entity
                    is "&amp;" then
                        res += "&"
                        i = semi + 1
                    is "&lt;" then
                        res += "<"
                        i = semi + 1
                    is "&gt;" then
                        res += ">"
                        i = semi + 1
                    is "&quot;" then
                        res += "\""
                        i = semi + 1
                    is "&#39;" then
                        res += "'"
                        i = semi + 1
                    else
                        res += ch
                        i += 1
                end
            else
                res += ch
                i += 1
            end
        else
            res += ch
            i += 1
        end
    end
    return res
end
