# Benchmark suite for mustache template engine
import "std/bench"
import "../src/lib.alya" as mustache
import "../src/escape.alya" as escape

function main()
    let runner = bench_runner("Mustache Template Engine Micro-Benchmarks")

    let ot = "{{"
    let ct = "}}"
    let tmpl_str = "Hello, " + ot + "name" + ct + "! Items: " + ot + "#items" + ct + ot + "." + ct + ", " + ot + "/items" + ct
    let data = {
        "name": "Benchmarker",
        "items": ["one", "two", "three", "four", "five"]
    }

    # 1. HTML Escaping Benchmark
    let raw_html = "<div class=\"user\">Hello & Welcome 'Antigravity' > 100</div>"
    bench_start(runner, 50000)
    let i = 0
    while i < 50000
        escape::escape_html(raw_html)
        i += 1
    end
    bench_stop(runner, "escape_html() 50k calls")

    # 2. Template Compilation Benchmark
    bench_start(runner, 10000)
    let j = 0
    while j < 10000
        mustache::compile(tmpl_str)
        j += 1
    end
    bench_stop(runner, "compile() 10k calls")

    # 3. Precompiled Template Rendering Benchmark
    let compiled = mustache::compile(tmpl_str)
    bench_start(runner, 25000)
    let k = 0
    while k < 25000
        mustache::render_template(compiled, data)
        k += 1
    end
    bench_stop(runner, "render_template() 25k calls")

    # 4. End-to-End Render (Compile + Render) Benchmark
    bench_start(runner, 10000)
    let m = 0
    while m < 10000
        mustache::render(tmpl_str, data)
        m += 1
    end
    bench_stop(runner, "render() [parse + eval] 10k calls")

    bench_summary(runner)
end

main()
